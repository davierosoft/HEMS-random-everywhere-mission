  "NEW DISPATCH":     {
      "commands": [
        {"sleep":5},
        {"wait_for":{"var":["L:{local:HXX}_SDK_OH_BATTERY_MASTER","number"]},"ne":0},
        {"if": {"local":"player"}, "eq": "singleplayer",
          "then": [
            {"while": 1, "gt": 0,
              "do": [
                {"or": [
                  {"wait_for":{"var":["L:DISPATCH_PHASE","number"]},"eq":5},
                  {"wait_for":{"var":["L:DISPATCH_PHASE","number"]},"eq":6}
                ]},
                {"call_macro":"ready dispatch"}
            ]}
          ],"else": [
            {"if": {"local":"player"}, "eq": "multiplayer",
              "then": [
                {"wait_for":{"var":["L:VAR_SEND_DISPATCH","number"]},"gt":0}
            ]},
            {"or": [
              {"wait_for":{"var":["L:DISPATCH_PHASE","number"]},"eq":5},
              {"wait_for":{"var":["L:DISPATCH_PHASE","number"]},"eq":6}
            ]},
            {"call_macro":"ready dispatch"}
        ]}
    ]},
  "DISPATCH MFD DISPLAY":     {
      "commands": [
        {"sleep":5},
        {"wait_for":{"var":["L:{local:HXX}_SDK_OH_BATTERY_MASTER","number"]},"ne":0},
