  "DISPATCH MFD DELETE":     {
      "commands": [
        {"sleep":5},
        {"wait_for":{"var":["L:{local:HXX}_SDK_OH_BATTERY_MASTER","number"]},"ne":0},
        {"while": 1, "gt": 0,
          "do": [
            {"wait_for":{"var":["L:{local:HXX}_SDK_IS_DISPATCH_MESSAGE","number"]},"eq":1},
