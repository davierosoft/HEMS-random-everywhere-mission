  "ambulance patient report snapshot":     {
      "commands": [
        {"while": 1, "gt": 0,
          "do": [
            {"if": {
              "and": [
                {"require":{"local":"ambulance_patient_report_finalized"},"ne":"yes"},
                {"or":[{"require":{"local":"whobringpatient"},"eq":"ambulance"},{"require":{"local":"whobringpatient"},"eq":"ambudoc"}],"eq":1},
                {"require":{"local":"crewvisitended"},"eq":"yes"}
              ]},
              "then": [
                {"if": {"local":"CPBPM"}, "ne": 0,
                  "then": [
                    {"set":{"local":"ambulance_final_hr"},"value":{"local":"CPBPM"}}
                  ],"else": [
                    {"set":{"local":"ambulance_final_hr"},"value":{"local":"BPM"}}
                ]},
                {"set":{"local":"ambulance_final_spo2"},"value":{"local":"SPO2"}},
                {"set":{"local":"ambulance_final_bp_sys"},"value":{"local":"BP_SYS"}},
                {"set":{"local":"ambulance_final_bp_dia"},"value":{"local":"BP_DIA"}},
                {"set":{"local":"ambulance_final_rr"},"value":{"local":"RR"}},
                {"set":{"local":"ambulance_final_temp"},"value":{"local":"TEMP"}},
                {"set":{"local":"ambulance_final_gcs_eye"},"value":{"local":"GCS_EYE"}},
                {"set":{"local":"ambulance_final_gcs_verbal"},"value":{"local":"GCS_VERBAL"}},
                {"set":{"local":"ambulance_final_gcs_motor"},"value":{"local":"GCS_MOTOR"}},
                {"set":{"local":"ambulance_final_gcs_total"},"value":{"local":"GCS_TOTAL"}},
                {"set":{"local":"ambulance_final_gcs_any_nt"},"value":{"local":"GCS_ANY_NT"}},
                {"set":{"local":"ambulance_final_code"},"value":{"var":["L:HEALTH","number"]}},
                {"if": {"local":"whobringpatient"}, "eq": "ambudoc",
                  "then": [
                    {"set":{"local":"ambulance_final_provider"},"value":"AMBULANCE CREW + HEMS DOCTOR"}
                  ],"else": [
                    {"set":{"local":"ambulance_final_provider"},"value":"AMBULANCE CREW"}
                ]},
                {"set":{"local":"ambulance_patient_report_finalized"},"value":"yes"}
              ],
              "eq": 1
            },
            {"sleep":0.5}
        ]}
    ]}
}
