{"EXTERNAL XML AUDIO ENABLE":     {
      "commands": [
        {"sleep":10},
        {"set":{"var":["L:TEMPAUDIOINHIBIT","number"]},"value":{"var":["L:AUDIOINHIBIT","number"]}},
        {"while": 1, "gt": 0,
          "do": [
            {"sleep":1},
            {"#comment":"VCP follows L:AUDIOINHIBIT every second (not only when the value changes): the simulator resets the LVAR to 0 when a flight or a mission is loaded and the Companion writes 1 again a moment later, so a change event can be missed and VCP would stay on the wav pack while the Companion plays the voices."},
            {"if": {"var":["L:AUDIOINHIBIT","number"]}, "eq": 0,
              "then": [
                {"if": {"local":"VCP"}, "ne": {"global":"VOICEPACK"},
                  "then": [
                    {"set":{"local":"VCP"},"value":{"global":"VOICEPACK"}}
                ]}
            ]},
            {"if": {
              "and": [
                {"require":{"var":["L:AUDIOINHIBIT","number"]},"ne":0},
                {"require":{"var":["L:AUDIOINHIBIT","number"]},"ne":100},
                {"require":{"local":"VCP"},"ne":"APP"}
              ]}, "eq": 1,
              "then": [
                {"set":{"local":"VCP"},"value":"APP"},
                {"call_macro":"voice app connect"}
            ]},
            {"set":{"var":["L:TEMPAUDIOINHIBIT","number"]},"value":{"var":["L:AUDIOINHIBIT","number"]}}
        ]}
    ]},
  "FUEL START UPDT":     {
      "commands": [
        {"while": 1, "gt": 0,
          "do": [
            {"and": [
              {"wait_for":{"global":"FUEL_MODE"},"eq":"real"},
              {"wait_for":{"local":"FUEL_UPDATED"},"eq":"done"},
              {"wait_for":{"var":["L:{local:HXX}_SDK_ROTOR_RPM","number"]},"gt":10}
            ]},
            {"set":{"global":"FUEL_START"},"value":{"var":["FUEL TANK CENTER LEVEL","PERCENT"]}},
            {"sleep":30}
        ]}
    ]},
  "FUEL HOSE CONNECTED":     {
      "commands": [
        {"while": 1, "gt": 0,
          "do": [
            {"and": [
              {"wait_for":{"local":"fuel truck arrived"},"eq":"yes"},
              {"wait_for":{"var":["SIM ON GROUND","bool"]},"eq":1},
              {"wait_for":{"var":["L:Collective","number"]},"gt":35},
              {"wait_for":{"var":["L:{local:HXX}_SDK_ROTOR_RPM","number"]},"gt":80}
            ]},
            {"set":{"var":["L:CPL{local:VCP}60","number"]},"value":{"add":[{"var":["L:CPL{local:VCP}60","number"]},1]}},
            {"sleep":10},
            {"wait_for":{"var":["L:Collective","number"]},"lte":35},
            {"or": [
              {"wait_for":{"local":"fuel truck arrived"},"ne":"yes"},
              {"wait_for":{"var":["SIM ON GROUND","bool"]},"eq":1},
              {"wait_for":{"var":["L:Collective","number"]},"lte":35}
            ]}
        ]}
    ]},
  "RESCUETRACKUPDATEFROMDMG":     {
      "commands": [
        {"sleep":5},
        {"set":{"local":"DISPATCH_PHASE_RAW_PREV"},"value":{"var":["L:DISPATCH_PHASE_RAW","number"]}},
        {"while": 1, "gt": 0,
          "do": [
            {"and": [
              {"wait_for":{"var":["L:DISPATCH_PHASE_RAW","number"]},"ne":100},
              {"wait_for":{"local":"DISPATCH_PHASE_RAW_PREV"},"ne":{"var":["L:DISPATCH_PHASE_RAW","number"]}}
            ]},
            {"set":{"local":"DISPATCH_PHASE_RAW_PREV"},"value":{"var":["L:DISPATCH_PHASE_RAW","number"]}},
            {"call_macro":"Update_dispatchphase from raw"},
            {"sleep":0.5}
        ]}
    ]},
  "ALTCONV":     {
      "commands": [
        {"while": 1, "gt": 0,
          "do": [
            {"set":{"var":["L:ALTCOPY","number"]},"value":{"var":["PLANE ALTITUDE","feet"]}},
            {"sleep":60}
        ]}
    ]},
  "WIFI":     {
      "commands": [
        {"or": [
          {"wait_for":{"has_location":"custom_center_location"},"eq":1},
          {"wait_for":{"has_location":"mission_start_location"},"eq":1}
        ]},
        {"while": 1, "gt": 0,
          "do": [
            {"if": {
              "and": [
                {"require":{"global":"location_ref"},"eq":"custom_center_location"},
                {"require":{"has_location":"custom_center_location"},"eq":1}
              ]}, "eq": 1,
              "then": [
                {"wait_for":{"location":"custom_center_location","var":"distance:m"},"lte":300},
                {"set":{"local":"wifiinrange"},"value":"in"},
                {"wait_for":{"location":"custom_center_location","var":"distance:m"},"gt":300},
                {"set":{"local":"wifiinrange"},"value":"out"},
                {"set":{"local":"wificonnect"},"value":"Disconnected"}
              ],"else": [
                {"wait_for":{"location":"mission_start_location","var":"distance:m"},"lte":300},
                {"set":{"local":"wifiinrange"},"value":"in"},
                {"wait_for":{"location":"mission_start_location","var":"distance:m"},"gt":300},
                {"set":{"local":"wificonnect"},"value":"Disconnected"},
                {"set":{"local":"wifiinrange"},"value":"out"}
            ]},
            {"sleep":[3,10]}
        ]}
    ]},
  "TABLET 5G connection":     {
      "commands": [
        {"while": 1, "gt": 0,
          "do": [
            {"if": {"global":"TABLET_5G_ENABLED"}, "eq": "yes",
              "then": [
                {"set":{"local":"TABLET_5G_FORCED"},"value":"yes"},
                {"set":{"local":"wificonnect"},"value":"Connected"},
                {"if": {"local":"TABLET_5G_NOTICE_STATE"}, "ne": "shown",
                  "then": [
                    {"set":{"local":"TABLET_5G_NOTICE_STATE"},"value":"shown"},
                    {"set":{"local":"TABLET_5G_DISPATCH_NOTICE"},"value":"visible"},
                    {"create_thread": {
                      "commands": [
                        {"sleep":5},
                        {"if": {"global":"TABLET_5G_ENABLED"}, "eq": "yes",
                          "then": [
                            {"set":{"local":"TABLET_5G_DISPATCH_NOTICE"},"value":"hidden"}
                        ]}
                    ]}}
                ]}
              ],"else": [
                {"if": {"local":"TABLET_5G_FORCED"}, "eq": "yes",
                  "then": [
                    {"set":{"local":"wificonnect"},"value":"Disconnected"},
                    {"set":{"local":"TABLET_5G_FORCED"},"value":"no"}
                ]},
                {"set":{"local":"TABLET_5G_DISPATCH_NOTICE"},"value":"hidden"},
                {"set":{"local":"TABLET_5G_NOTICE_STATE"},"value":"idle"}
            ]},
            {"sleep":1}
        ]}
    ]},
  "HOC connection":     {
      "commands": [
        {"or": [
          {"wait_for":{"has_location":"custom_center_location"},"eq":1},
          {"wait_for":{"has_location":"mission_start_location"},"eq":1}
        ]},
        {"while": 1, "gt": 0,
          "do": [
            {"or": [
              {"wait_for":{"local":"wificonnect"},"eq":"Connected"},
              {"wait_for":{"var":["L:CARLS_CONNECTED","number"]},"eq":1}
            ]},
            {"sleep":[1,2]},
            {"set":{"local":"HOCconnection"},"value":"Connected"},
            {"and": [
              {"wait_for":{"local":"wificonnect"},"ne":"Connected"},
              {"wait_for":{"var":["L:CARLS_CONNECTED","number"]},"ne":1}
            ]},
            {"set":{"local":"HOCconnection"},"value":"Disconnected"}
        ]}
    ]},
  "Acceptdispatch 0":     {
      "commands": [
        {"sleep":13},
        {"while": 1, "gt": 0,
          "do": [
            {"wait_for":{"var":["L:DISPATCH_PHASE","number"]},"eq":0},
            {"call_macro":"accept_dispatch"},
            {"wait_for":{"var":["L:DISPATCH_PHASE","number"]},"ne":0}
        ]}
    ]},
