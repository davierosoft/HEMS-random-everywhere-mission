SIST_IBF_INSTALLED","number"]},"ne":{"local":"SW_K12"}},{"wait_for":{"var":["L:{local:HXX}_SDK_EQUIP_AIRCONDITIONING","number"]},"ne":{"local":"SW_K13"}},{"wait_for":{"var":["L:{local:HXX}_SDK_EQUIP_ADELT","number"]},"ne":{"local":"SW_K14"}},{"wait_for":{"var":["L:{local:HXX}_SDK_EQUIP_ACAS","number"]},"ne":{"local":"SW_K15"}},{"wait_for":{"var":["L:{local:HXX}_SDK_EQUIP_HTAWS","number"]},"ne":{"local":"SW_K16"}},{"wait_for":{"var":["L:{local:HXX}_SDK_EQUIP_HMD","number"]},"ne":{"local":"SW_K17"}},{"wait_for":{"var":["L:{local:HXX}_SDK_EQUIP_FUELFLOWSENSOR","number"]},"ne":{"local":"SW_K18"}},{"wait_for":{"var":["L:{local:HXX}_SDK_EQUIP_SECOND_LANDING_LIGHT","number"]},"ne":{"local":"SW_K19"}},{"wait_for":{"var":["L:{local:HXX}_SDK_EQUIP_CHIN_WINDOW_PLATES","number"]},"ne":{"local":"SW_K20"}},{"wait_for":{"var":["L:{local:HXX}_PERSIST_COCKPIT_SUN_VISORS","number"]},"ne":{"local":"SW_K21"}},{"wait_for":{"var":["L:{local:HXX}_PERSIST_COCKPIT_FABRIC_GLARESHIELDS","number"]},"ne":{"local":"SW_K22"}}],"eq":1},
            {"call_macro":"station weights read"},
