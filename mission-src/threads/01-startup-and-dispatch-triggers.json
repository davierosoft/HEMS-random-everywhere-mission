            {"modify_array":{"local":"dispatch_handoff_log"},"append":{"create_struct":{"stage":"dispatch_phase_changed","time":{"fn":"get_time_string"},"mission_timer":{"var":["L:MISSION_TIME","number"]},"phase":{"local":"MISSION_PHASE"},"dispatch_phase":{"var":["L:DISPATCH_PHASE","number"]},"phase_raw":{"var":["L:DISPATCH_PHASE_RAW","number"]},"phase_writer":{"local":"dispatch_phase_writer"},"rtb_step":{"local":"rtb_step"},"copy_seq":{"local":"ready_copy_seq"},"copy_id":{"local":"ready_copy_id"},"ndt_runs":{"local":"ndt_runs"},"wait_second_s":{"local":"WAIT_SECOND_DISPATCH"},"endwait_s":{"local":"ENDWAIT_SECOND_DISPATCH"},"rdw_t0":{"local":"rdw_t0"}}}},
            {"if": {"struct":{"local":"dispatch_handoff_log"},"path":"length"}, "gt": 150,
              "then": [
                {"modify_array":{"local":"dispatch_handoff_log"},"removeIndex":0}
            ]},
            {"sleep":0.2}
        ]}
    ]},
