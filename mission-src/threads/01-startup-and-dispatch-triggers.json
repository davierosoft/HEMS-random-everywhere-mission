{"EXTERNAL XML AUDIO ENABLE":     {
      "commands": [
        {"sleep":10},
        {"set":{"var":["L:TEMPAUDIOINHIBIT","number"]},"value":{"var":["L:AUDIOINHIBIT","number"]}},
        {"while": 1, "gt": 0,
          "do": [
            {"sleep":1},
            {"#comment":"VCP follows L:AUDIOINHIBIT every second (not only when the value changes): the simulator resets the LVAR to 0 when a flight or a mission is loaded and the Companion writes 1 again a moment later, so a change event can be missed and VCP would stay on the wav pack while the Companion plays the voices."},
            {"if": {"var":["L:AUDIOINHIBIT","number"]}, "eq": 0,
              "then": [
                {"if": {"local":"VCP"}, "ne": {"global":"VOICEPACK"},
                  "then": [
                    {"set":{"local":"VCP"},"value":{"global":"VOICEPACK"}},
                    {"call_macro":"ground crew runtime trace","params":{"macro":"voice_vcp","actor":"n/a","target":{"local":"VCP"},"state":{"text":"VCP now {0} (set in EXTERNAL XML AUDIO ENABLE): AUDIOINHIBIT={1} TTS={2}","params":[{"local":"VCP"},{"var":["L:AUDIOINHIBIT","number"]},{"local":"TTS"}]}}}
                ]}
            ]},
            {"if": {
              "and": [
                {"require":{"var":["L:AUDIOINHIBIT","number"]},"ne":0},
                {"require":{"var":["L:AUDIOINHIBIT","number"]},"ne":100},
                {"require":{"local":"VCP"},"ne":"APP"}
              ]}, "eq": 1,
              "then": [
                {"set":{"local":"VCP"},"value":"APP"},
                {"call_macro":"ground crew runtime trace","params":{"macro":"voice_vcp","actor":"n/a","target":{"local":"VCP"},"state":{"text":"VCP now {0} (set in EXTERNAL XML AUDIO ENABLE): AUDIOINHIBIT={1} TTS={2}","params":[{"local":"VCP"},{"var":["L:AUDIOINHIBIT","number"]},{"local":"TTS"}]}}},
                {"call_macro":"voice app connect"}
            ]},
            {"#comment":"Companion selected (L:AUDIOINHIBIT 1) but no voice server answer: voice app check counts the connection as lost after 25 s (voice app lost: back to the wav pack, L:AUDIOINHIBIT 0, one popup per session). The wav pack selected by the user is the fallback, never silence."},
            {"if": {
              "and": [
                {"require":{"var":["L:AUDIOINHIBIT","number"]},"ne":0},
                {"require":{"var":["L:AUDIOINHIBIT","number"]},"ne":100},
                {"require":{"local":"VCP"},"eq":"APP"},
                {"require":{"local":"TTS"},"ne":1}
              ]}, "eq": 1,
              "then": [
                {"call_macro":"voice app check"}
            ]},
            {"set":{"var":["L:TEMPAUDIOINHIBIT","number"]},"value":{"var":["L:AUDIOINHIBIT","number"]}}
        ]}
    ]},
