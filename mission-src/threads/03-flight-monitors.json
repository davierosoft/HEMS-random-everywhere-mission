            ]},
            {"sleep":5},
            {"wait_for":{"var":["SIM ON GROUND","bool"]},"eq":1},
            {"sleep":0.3},
            {"and": [
              {"wait_for":{"var":["SIM ON GROUND","bool"]},"eq":1},
              {"wait_for":{"var":["L:{local:HXX}_SDK_LAST_LANDING_RATE","number"]},"lt":0},
              {"wait_for":{"var":["L:{local:HXX}_SDK_LAST_LANDING_RATE","number"]},"gt":-40}
            ]},
            {"if": {"local":"softlanding"}, "lte": 2,
              "then": [
                {"set":{"local":"softlanding"},"value":{"add":[{"local":"softlanding"},1]}},
                {"set":{"var":["L:CPL{local:VCP}41","number"]},"value":{"add":[{"var":["L:CPL{local:VCP}41","number"]},1]}},
                {"sleep":3}
            ]},
            {"wait_for":{"var":["SIM ON GROUND","bool"]},"eq":0},
            {"wait_for":{"var":["RADIO HEIGHT","feet"]},"gt":20}
        ]}
    ]},
