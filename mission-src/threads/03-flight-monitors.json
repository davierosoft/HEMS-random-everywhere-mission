  "landing soft":     {
      "commands": [
        {"sleep":10},
        {"wait_for":{"var":["L:{local:HXX}_SDK_OH_BATTERY_MASTER","number"]},"ne":0},
        {"while": 1, "gt": 0,
          "do": [
            {"or": [
              {"wait_for":{"global":"AUDIO_DECLUT"},"lt":3},
