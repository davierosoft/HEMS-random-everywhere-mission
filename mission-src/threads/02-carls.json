  "CARLS DF":     {
      "commands": [
        {"while": 1, "gt": 0,
          "do": [
            {"wait_for":{"var":["L:CARLS_PAGE","number"]},"eq":13},
            {"call_macro":"CARLS buttons"},
            {"call_macro":"CARLS DF render"},
            {"while": {"var":["L:CARLS_PAGE","number"]}, "eq": 13,
              "do": [
                {"if": {
                  "and": [
                    {"require":{"global":"CARLS_DF_EDITING"},"eq":1},
                    {"require":{"global":"CARLS_DF_INPUT_ERROR"},"eq":1},
                    {"require":{"subtract":[{"var":["L:MISSION_TIME","number"]},{"global":"CARLS_DF_LAST_INPUT_TIME"}]},"gte":1.5}
                  ]}, "eq": 1,
