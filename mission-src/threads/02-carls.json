  "CARLS STP":     {
      "commands": [
        {"while": 1, "gt": 0,
          "do": [
            {"or": [
              {"wait_for":{"var":["L:CARLS_PAGE","number"]},"eq":6},
              {"wait_for":{"var":["L:CARLS_PAGE","number"]},"eq":12}
            ]},
            {"wait_for":{"var":["L:CARLS_TEMP","number"]},"eq":2},
            {"call_macro":"CARLS buttons"},
