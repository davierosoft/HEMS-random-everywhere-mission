                    {"sleep":[3,10]},
                    {"call_macro":"CARLS buttons"},
                    {"set":{"var":["L:CARLS_CONNECTED","number"]},"value":1}
                ]}
            ]}
        ]},
        {"while": 1, "gt": 0,
          "do": [
            {"wait_for":{"var":["L:CARLS_State","number"]},"eq":0},
            {"set":{"var":["L:CARLS_CONNECTED","number"]},"value":0},
            {"set":{"var":["L:CARLS_PAGE","number"]},"value":0},
            {"set_carls_radio":{"LSK":["","",""],"RSK":["","",""],"Items":[["",""],["",""],["",""]]}},
            {"wait_for":{"var":["L:CARLS_State","number"]},"ne":0},
            {"sleep":1},
            {"set_carls_radio":{"LSK":["","",""],"RSK":["","",""],"Items":[["",""],["","Loading..."],["",""]]}},
            {"sleep":4},
            {"set_carls_radio":{"LSK":["","",""],"RSK":["","",""],"Items":[["","elektronik-labor"],["CARLS","HBE767 M"],[" Radio ctrl sys","PBIT in progress..."]]}},
            {"sleep":{"global":"CARLSPBIT"}},
            {"set":{"var":["L:CARLS_PAGE","number"]},"value":0},
            {"set_carls_radio":{"LSK":["DF","","MSG"],"RSK":["GRP","MOD","STP"],"Items":[["",""],[{"text":"{0}","params":[{"global":"GRPNAME"}]},{"text":"{0}","params":[{"global":"GRPNUM"}]}],["Push call to","connect"]]}},
            {"call_macro":"CARLS buttons"},
            {"create_event_handler": "MISSION_RADIO_CARLS_PICK",
              "commands": [
                {"if": {"var":["L:CARLS_CONNECTED","number"]}, "ne": 1,
                  "then": [
                    {"set_message":{"text":"CONNECTING TO DOC..."}},
                    {"set":{"var":["L:CARLS_PAGE","number"]},"value":0},
                    {"set_carls_radio":{"LSK":["DF","","MSG"],"RSK":["GRP","MOD","STP"],"Items":[["",""],[{"text":"{0}","params":[{"global":"GRPNAME"}]},{"text":"{0}","params":[{"global":"GRPNUM"}]}],["&nbsp;","Connecting to grp"]]}},
                    {"sleep":[3,10]},
                    {"set":{"var":["L:CARLS_CONNECTED","number"]},"value":1}
                ]}
            ]},
            {"wait_for":{"var":["L:CARLS_State","number"]},"eq":0},
            {"set_message":{"text":"DISCONNECTED FROM DOC"}},
            {"set_carls_radio":{"LSK":["","",""],"RSK":["","",""],"Items":[["",""],["",""],["",""]]}}
        ]}
    ]},
