                {"if": {
                  "and": [
                    {"require":{"global":"CARLS_DF_EDITING"},"eq":1},
                    {"require":{"global":"CARLS_DF_INPUT_ERROR"},"eq":0},
                    {"require":{"subtract":[{"var":["L:MISSION_TIME","number"]},{"global":"CARLS_DF_LAST_INPUT_TIME"}]},"gte":5}
                  ]}, "eq": 1,
                  "then": [
                    {"call_macro":"CARLS DF timeout"}
