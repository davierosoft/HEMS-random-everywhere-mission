{"CARLS STARTUP":     {
      "commands": [
        {"sleep":1},
        {"if": {"var":["L:CARLS_State","number"]}, "eq": 2,
          "then": [
            {"if": {"var":["L:CUS_CARLS_AUTOCONNECT","number"]}, "ne": 0,
              "then": [
                {"set":{"var":["L:CARLS_CONNECTED","number"]},"value":1},
                {"sleep":0.5}
            ]},
            {"set":{"var":["L:CARLS_PAGE","number"]},"value":0},
            {"set_carls_radio":{"LSK":["DF","","MSG"],"RSK":["GRP","MOD","STP"],"Items":[["",""],[{"text":"{0}","params":[{"global":"GRPNAME"}]},{"text":"{0}","params":[{"global":"GRPNUM"}]}],{"item":["Push call to","connect"],"show_condition":{"require":{"var":["L:CARLS_CONNECTED","number"]},"eq":0}},{"item":["&nbsp;","Connecting to grp"],"show_condition":{"require":{"var":["L:CARLS_CONNECTED","number"]},"gt":1}}]}},
