{"vox glitch start": [
    {"#comment":"ICS VOX glitch of the crew headsets (Andrew 2026-11-21). Started by objective1 at every load, one loop only. No option: the roll (20 percent per flight) is the only gate."},
    {"if": {"local":"vox_running"}, "ne": 1,
      "then": [
        {"set":{"local":"vox_running"},"value":1},
        {"set":{"local":"vox_rolled"},"value":0},
        {"set":{"local":"vox_done"},"value":0},
        {"create_thread": {
          "commands": [
            {"call_macro":"vox glitch loop"}
        ]}}
    ]}
  ],
  "vox glitch ready": [
    {"#comment":"Sets vox_ready 1 when the glitch can happen: ICS powered (battery or GPCP switch), an engine running (N1 above 20), rotor above 40 percent, collective above 20 and somebody else aboard."},
    {"set":{"local":"vox_ready"},"value":0},
    {"call_macro":"vox pick crew"},
    {"if": {"local":"vox_who"}, "gt": 0,
      "then": [
        {"if": {"var":["L:{local:HXX}_SDK_ROTOR_RPM","number"]}, "gt": 40,
          "then": [
            {"if": {"var":["L:Collective","number"]}, "gt": 20,
              "then": [
                {"if": {"var":["L:{local:HXX}_SDK_ENG_1_N1","number"]}, "gt": 20,
                  "then": [
                    {"set":{"local":"vox_eng"},"value":1}
                  ],"else": [
                    {"if": {"var":["L:{local:HXX}_SDK_ENG_2_N1","number"]}, "gt": 20,
                      "then": [
                        {"set":{"local":"vox_eng"},"value":1}
                      ],"else": [
                        {"set":{"local":"vox_eng"},"value":0}
                    ]}
                ]},
                {"if": {"local":"vox_eng"}, "eq": 1,
                  "then": [
                    {"if": {"var":["L:{local:HXX}_SDK_OH_BATTERY_MASTER","number"]}, "eq": 1,
                      "then": [
                        {"set":{"local":"vox_ready"},"value":1}
                      ],"else": [
                        {"if": {"var":["L:{local:HXX}_SDK_GPCP_PWR_SWITCH","number"]}, "eq": 1,
                          "then": [
                            {"set":{"local":"vox_ready"},"value":1}
                        ]}
                    ]}
                ]}
            ]}
        ]}
    ]}
  ],
