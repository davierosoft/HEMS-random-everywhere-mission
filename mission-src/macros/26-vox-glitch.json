            {"call_macro":"voice say","params":{"key":"VOX.FIX.P3"}}
        ]}
    ]}
  ],
  "vox comm check": [
    {"#comment":"The operator who fixed the VOX does his own comm check line (same variables as COMM CHECK)."},
    {"if": {"local":"vox_who"}, "eq": 1,
      "then": [
        {"set":{"var":["L:CPL{local:VCP}5","number"]},"value":{"add":[{"var":["L:CPL{local:VCP}5","number"]},1]}}
    ]},
    {"if": {"local":"vox_who"}, "eq": 2,
      "then": [
        {"set":{"var":["L:{local:VCP}25","number"]},"value":{"add":[{"var":["L:{local:VCP}25","number"]},1]}}
    ]},
    {"if": {"local":"vox_who"}, "eq": 3,
      "then": [
        {"set":{"var":["L:PAX2{local:VCP}1","number"]},"value":{"add":[{"var":["L:PAX2{local:VCP}1","number"]},1]}}
    ]},
    {"if": {"local":"vox_who"}, "eq": 4,
      "then": [
        {"set":{"var":["L:PAX3{local:VCP}2","number"]},"value":{"add":[{"var":["L:PAX3{local:VCP}2","number"]},1]}}
    ]}
  ]
