  "vox glitch loop": [
    {"#comment":"Once per flight: roll 20 percent, then N = 1 to 5 bursts with random gaps. After the third burst: a crew member asks to check the VOX. After the last burst (more than 2): a random operator fixes it and does a comm check."},
    {"while": 1, "gt": 0,
      "do": [
        {"if": {"local":"vox_done"}, "eq": 1,
          "then": [
            {"sleep":30}
          ],"else": [
            {"call_macro":"vox glitch ready"},
            {"if": {"local":"vox_ready"}, "eq": 1,
              "then": [
                {"if": {"local":"vox_rolled"}, "ne": 1,
                  "then": [
                    {"set":{"local":"vox_rolled"},"value":1},
                    {"set":{"local":"vox_count"},"value":0},
                    {"set":{"local":"vox_left"},"value":{"floor":{"rand":[1,6]}}},
                    {"set":{"local":"vox_roll"},"value":{"rand":[0,100]}},
                    {"if": {"local":"vox_roll"}, "gte": 20,
                      "then": [
                        {"set":{"local":"vox_done"},"value":1}
                    ]},
                    {"set":{"local":"vox_total"},"value":{"local":"vox_left"}}
                  ],"else": [
                    {"set":{"local":"vox_gap"},"value":{"rand":[15,60]}},
                    {"sleep":{"local":"vox_gap"}},
                    {"call_macro":"vox glitch ready"},
                    {"if": {"local":"vox_ready"}, "eq": 1,
                      "then": [
                        {"call_macro":"vox glitch burst"}
                    ]}
                ]}
              ],"else": [
                {"sleep":3}
            ]},
            {"sleep":1}
        ]}
    ]}
  ],
  "vox glitch burst": [
    {"#comment":"One burst: the Companion plays ICS hiss and wind for L:HMC_VOX_DUR milliseconds (counter L:HMC_VOX_SEQ). The mission only publishes it."},
    {"set":{"local":"vox_ms"},"value":{"floor":{"rand":[500,2001]}}},
    {"set":{"var":["L:HMC_VOX_DUR","number"]},"value":{"local":"vox_ms"}},
    {"set":{"var":["L:HMC_VOX_SEQ","number"]},"value":{"add":[{"var":["L:HMC_VOX_SEQ","number"]},1]}},
    {"sleep":{"divide":[{"local":"vox_ms"},1000]}},
    {"set":{"local":"vox_count"},"value":{"add":[{"local":"vox_count"},1]}},
    {"set":{"local":"vox_left"},"value":{"subtract":[{"local":"vox_left"},1]}},
    {"if": {"local":"vox_count"}, "eq": 3,
      "then": [
        {"sleep":2},
        {"call_macro":"vox pick crew"},
        {"call_macro":"vox say","params":{"kind":"ASK"}}
    ]},
    {"if": {"local":"vox_left"}, "lte": 0,
      "then": [
        {"set":{"local":"vox_done"},"value":1},
        {"if": {"local":"vox_count"}, "gt": 2,
          "then": [
            {"set":{"local":"vox_gap"},"value":{"rand":[6,12]}},
            {"sleep":{"local":"vox_gap"}},
            {"call_macro":"vox pick crew"},
            {"call_macro":"vox say","params":{"kind":"FIX"}},
            {"sleep":3},
            {"call_macro":"vox comm check"}
        ]}
    ]}
  ],
  "vox say": [
    {"#comment":"Pack line VOX.<kind>.<who> (kind ASK or FIX) spoken by the crew member picked in vox_who: 1 copilot (CPL), 2 PAX1, 3 PAX2, 4 PAX3."},
    {"if": {"param":"kind"}, "eq": "ASK",
      "then": [
        {"if": {"local":"vox_who"}, "eq": 1,
          "then": [
            {"call_macro":"voice say","params":{"key":"VOX.ASK.CPL"}}
        ]}
    ]},
    {"if": {"param":"kind"}, "eq": "ASK",
      "then": [
        {"if": {"local":"vox_who"}, "eq": 2,
          "then": [
