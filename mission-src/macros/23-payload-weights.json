            {"set":{"local":"KITT_6"},"value":{"add":[{"local":"KITT_6"},7.5]}}
        ]},
        {"if": {"var":["L:{local:HXX}_SDK_EQUIP_ADELT","number"]}, "eq": 1,
          "then": [
            {"set":{"local":"KITT_5"},"value":{"add":[{"local":"KITT_5"},3.5]}},
            {"set":{"local":"KITT_6"},"value":{"add":[{"local":"KITT_6"},3.5]}}
        ]},
        {"if": {"var":["L:{local:HXX}_SDK_EQUIP_ACAS","number"]}, "eq": 1,
          "then": [
            {"set":{"local":"KITT_1"},"value":{"add":[{"local":"KITT_1"},2]}},
            {"set":{"local":"KITT_2"},"value":{"add":[{"local":"KITT_2"},2]}}
        ]},
        {"if": {"var":["L:{local:HXX}_SDK_EQUIP_HTAWS","number"]}, "eq": 1,
          "then": [
            {"set":{"local":"KITT_1"},"value":{"add":[{"local":"KITT_1"},1]}},
            {"set":{"local":"KITT_2"},"value":{"add":[{"local":"KITT_2"},1]}}
        ]},
        {"if": {"var":["L:{local:HXX}_SDK_EQUIP_HMD","number"]}, "eq": 1,
          "then": [
            {"set":{"local":"KITT_1"},"value":{"add":[{"local":"KITT_1"},2]}},
            {"set":{"local":"KITT_2"},"value":{"add":[{"local":"KITT_2"},2]}}
        ]},
        {"if": {"var":["L:{local:HXX}_SDK_EQUIP_FUELFLOWSENSOR","number"]}, "eq": 1,
          "then": [
            {"set":{"local":"KITT_5"},"value":{"add":[{"local":"KITT_5"},0.5]}},
            {"set":{"local":"KITT_6"},"value":{"add":[{"local":"KITT_6"},0.5]}}
        ]},
        {"if": {"var":["L:{local:HXX}_SDK_EQUIP_SECOND_LANDING_LIGHT","number"]}, "eq": 1,
          "then": [
            {"set":{"local":"KITT_1"},"value":{"add":[{"local":"KITT_1"},1]}},
            {"set":{"local":"KITT_2"},"value":{"add":[{"local":"KITT_2"},1]}}
        ]},
        {"if": {"var":["L:{local:HXX}_SDK_EQUIP_CHIN_WINDOW_PLATES","number"]}, "eq": 1,
          "then": [
            {"set":{"local":"KITT_1"},"value":{"add":[{"local":"KITT_1"},1]}},
            {"set":{"local":"KITT_2"},"value":{"add":[{"local":"KITT_2"},1]}}
        ]},
        {"if": {"var":["L:{local:HXX}_PERSIST_COCKPIT_SUN_VISORS","number"]}, "eq": 1,
          "then": [
            {"set":{"local":"KITT_1"},"value":{"add":[{"local":"KITT_1"},0.5]}},
            {"set":{"local":"KITT_2"},"value":{"add":[{"local":"KITT_2"},0.5]}}
        ]},
        {"if": {"var":["L:{local:HXX}_PERSIST_COCKPIT_FABRIC_GLARESHIELDS","number"]}, "eq": 1,
          "then": [
            {"set":{"local":"KITT_1"},"value":{"add":[{"local":"KITT_1"},0.5]}},
            {"set":{"local":"KITT_2"},"value":{"add":[{"local":"KITT_2"},0.5]}}
        ]}
    ]}
  ]
}
