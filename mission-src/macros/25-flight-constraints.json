{"flight constraints start": [
    {"#comment":"Flight constraints (doctor review v2). Started by objective1 at every load; the loop waits for the option FLIGHT_CONSTRAINTS = yes (default no until the runtime test) and for a patient on the stretcher."},
    {"if": {"local":"fc_running"}, "ne": 1,
      "then": [
        {"set":{"local":"fc_running"},"value":1},
        {"create_thread": {
          "commands": [
            {"call_macro":"flight constraints loop"}
        ]}}
    ]}
  ],
  "flight constraints loop": [
    {"while": 1, "gt": 0,
      "do": [
        {"wait_for":{"global":"FLIGHT_CONSTRAINTS"},"eq":"yes"},
        {"if": {"var":["L:{local:HXX}_SDK_CABIN_PAX_5","number"]}, "eq": 2,
          "then": [
            {"call_macro":"flight constraints sample"},
            {"sleep":0.5}
          ],"else": [
            {"call_macro":"flight constraints reset"},
            {"sleep":2}
        ]}
    ]}
  ],
  "flight constraints reset": [
    {"set":{"local":"fc_pickup_alt"},"value":null},
    {"set":{"local":"fc_state_G"},"value":0},
    {"set":{"local":"fc_cd_G"},"value":0},
    {"set":{"local":"fc_state_GX"},"value":0},
    {"set":{"local":"fc_cd_GX"},"value":0},
    {"set":{"local":"fc_state_GZ"},"value":0},
    {"set":{"local":"fc_cd_GZ"},"value":0},
    {"set":{"local":"fc_state_NOISE"},"value":0},
    {"set":{"local":"fc_cd_NOISE"},"value":0},
    {"set":{"local":"fc_state_BANK"},"value":0},
    {"set":{"local":"fc_cd_BANK"},"value":0},
    {"set":{"local":"fc_state_PITCH"},"value":0},
    {"set":{"local":"fc_cd_PITCH"},"value":0},
    {"set":{"local":"fc_state_PDOWN"},"value":0},
    {"set":{"local":"fc_cd_PDOWN"},"value":0},
    {"set":{"local":"fc_state_ALT"},"value":0},
    {"set":{"local":"fc_cd_ALT"},"value":0},
    {"set":{"local":"fc_clear_due"},"value":0}
  ],
  "flight constraints sample": [
    {"#comment":"One sample of the flight constraints (doctor review v2, minimal set: altitude above 3000 ft AMSL, vertical load, bank, pitch up). Runs every 0.5 s while the stretcher holds a patient (SDK_CABIN_PAX_5 = 2). Penalty at 100 percent of the limit: 5 points, at 130 percent: 10, every 10 s while exceeded; a warning on every tier change; CLEAR when all are below 80 percent. Altitude: SpO2 (patient 1 SPO2, others Pn_SPO2), the others: lifescore. Pitch: nose-up is NEGATIVE in the simulator. Needs the patient profile Pn_FC_PROFILE (data field flight_constraint_profile)."},
    {"set":{"local":"fc_n"},"value":{"local":"HEMS_PATIENT_NUMBER"}},
    {"if": {"local":"fc_n"}, "eq": null,
      "then": [
        {"set":{"local":"fc_n"},"value":1}
    ]},
    {"if": {"local":"fc_n"}, "lt": 1,
      "then": [
        {"set":{"local":"fc_n"},"value":1}
    ]},
    {"set":{"local":"fc_profile"},"value":null},
    {"if": {"local":"fc_n"}, "eq": 1,
      "then": [
        {"set":{"local":"fc_profile"},"value":{"local":"P1_FC_PROFILE"}}
    ]},
    {"if": {"local":"fc_n"}, "eq": 2,
      "then": [
        {"set":{"local":"fc_profile"},"value":{"local":"P2_FC_PROFILE"}}
    ]},
    {"if": {"local":"fc_n"}, "eq": 3,
      "then": [
        {"set":{"local":"fc_profile"},"value":{"local":"P3_FC_PROFILE"}}
    ]},
    {"if": {"local":"fc_profile"}, "eq": null,
      "then": [
        {"return":0}
    ]},
    {"set":{"local":"fc_lim_g"},"value":0},
    {"set":{"local":"fc_lim_bank"},"value":0},
    {"set":{"local":"fc_lim_pitch"},"value":0},
    {"set":{"local":"fc_lim_gx"},"value":0},
    {"set":{"local":"fc_lim_gz"},"value":0},
    {"set":{"local":"fc_lim_pdown"},"value":0},
    {"set":{"local":"fc_lim_noise"},"value":0},
    {"set":{"local":"fc_alt_rel"},"value":null},
    {"set":{"local":"fc_alt_abs"},"value":null},
    {"call_macro":"flight constraints limits","params":{"profile":{"local":"fc_profile"}}},
    {"#comment":"Automatic medical mode: the headset is fitted by default (Andrew 2026-11-21), so the noise never hurts."},
    {"if": {"global":"P1_MANUAL_MEDICAL_MODE"}, "ne": "manual",
      "then": [
        {"set":{"local":"fc_lim_noise"},"value":0}
    ]},
    {"if": {"local":"fc_n"}, "eq": 1,
      "then": [
        {"if": {"local":"P1_HEADSET"}, "eq": 1,
          "then": [
            {"set":{"local":"fc_lim_noise"},"value":0}
        ]}
    ]},
    {"if": {"local":"fc_n"}, "eq": 2,
      "then": [
        {"if": {"local":"P2_HEADSET"}, "eq": 1,
          "then": [
            {"set":{"local":"fc_lim_noise"},"value":0}
        ]}
    ]},
    {"if": {"local":"fc_n"}, "eq": 3,
      "then": [
        {"if": {"local":"P3_HEADSET"}, "eq": 1,
          "then": [
            {"set":{"local":"fc_lim_noise"},"value":0}
        ]}
    ]},
    {"set":{"local":"fc_alt"},"value":{"var":["A:PLANE ALTITUDE","feet"]}},
    {"if": {"local":"fc_pickup_alt"}, "eq": null,
      "then": [
        {"set":{"local":"fc_pickup_alt"},"value":{"local":"fc_alt"}}
    ]},
    {"set":{"local":"fc_lim_alt"},"value":0},
    {"if": {"local":"fc_alt_rel"}, "ne": null,
      "then": [
        {"set":{"local":"fc_lim_alt"},"value":{"add":[{"local":"fc_pickup_alt"},{"local":"fc_alt_rel"}]}}
    ]},
    {"if": {"local":"fc_alt_abs"}, "ne": null,
      "then": [
        {"if": {"local":"fc_lim_alt"}, "lte": 0,
          "then": [
            {"set":{"local":"fc_lim_alt"},"value":{"local":"fc_alt_abs"}}
          ],"else": [
            {"if": {"local":"fc_alt_abs"}, "lt": {"local":"fc_lim_alt"},
              "then": [
                {"set":{"local":"fc_lim_alt"},"value":{"local":"fc_alt_abs"}}
            ]}
        ]}
    ]},
    {"if": {"local":"fc_lim_alt"}, "gt": 0,
      "then": [
        {"if": {"local":"fc_lim_alt"}, "lt": 3000,
          "then": [
            {"set":{"local":"fc_lim_alt"},"value":3000}
        ]}
    ]},
    {"if": {"local":"fc_lim_g"}, "gt": 0,
      "then": [
        {"set":{"local":"fc_v_G"},"value":{"var":["ACCELERATION BODY Y","Feet per second squared"]}},
        {"if": {"local":"fc_v_G"}, "lt": 0,
          "then": [
            {"set":{"local":"fc_v_G"},"value":{"multiply":[{"local":"fc_v_G"},-1]}}
        ]},
        {"set":{"local":"fc_r_G"},"value":{"multiply":[{"divide":[{"local":"fc_v_G"},{"local":"fc_lim_g"}]},100]}},
        {"set":{"local":"fc_cd_G"},"value":{"clamp":[{"subtract":[{"local":"fc_cd_G"},0.5]},0,60]}},
        {"if": {"local":"fc_r_G"}, "gte": 100,
          "then": [
            {"set":{"local":"fc_pen"},"value":5},
            {"set":{"local":"fc_tier"},"value":1},
            {"if": {"local":"fc_r_G"}, "gte": 130,
              "then": [
                {"set":{"local":"fc_pen"},"value":10},
                {"set":{"local":"fc_tier"},"value":2}
            ]},
            {"if": {"local":"fc_cd_G"}, "lte": 0,
              "then": [
                {"call_macro":"flight constraints penalty","params":{"patient":{"local":"fc_n"},"kind":"G","amount":{"local":"fc_pen"}}},
                {"set":{"local":"fc_cd_G"},"value":10}
            ]},
            {"if": {"local":"fc_state_G"}, "lt": {"local":"fc_tier"},
              "then": [
                {"set":{"local":"fc_state_G"},"value":{"local":"fc_tier"}},
                {"call_macro":"voice say","params":{"key":"FC.G"}},
                {"call_macro":"flight constraints tablet","params":{"kind":"G"}}
            ]}
          ],"else": [
            {"if": {"local":"fc_r_G"}, "lt": 80,
              "then": [
                {"if": {"local":"fc_state_G"}, "gt": 0,
                  "then": [
