  "flight constraints penalty": [
    {"#comment":"Applies one penalty to patient n (kind PITCH also lowers the systolic pressure by amount + 5, i.e. 10 or 15, and the lifescore by 5, as the doctor asked): kind ALT lowers the SpO2 (patient 1 SPO2, others Pn_SPO2), every other kind the lifescore through the registry override (slot n) with the local as a fallback outside the live registry."},
    {"if": {"param":"kind"}, "eq": "ALT",
      "then": [
        {"if": {"param":"patient"}, "eq": 1,
          "then": [
            {"set":{"local":"SPO2"},"value":{"clamp":[{"subtract":[{"local":"SPO2"},{"param":"amount"}]},0,100]}}
        ]},
        {"if": {"param":"patient"}, "eq": 2,
          "then": [
            {"set":{"local":"P2_SPO2"},"value":{"clamp":[{"subtract":[{"local":"P2_SPO2"},{"param":"amount"}]},0,100]}}
        ]},
        {"if": {"param":"patient"}, "eq": 3,
          "then": [
            {"set":{"local":"P3_SPO2"},"value":{"clamp":[{"subtract":[{"local":"P3_SPO2"},{"param":"amount"}]},0,100]}}
        ]},
        {"return":1}
    ]},
    {"if": {"param":"kind"}, "eq": "PITCH",
      "then": [
        {"set":{"local":"fc_bp"},"value":{"add":[{"param":"amount"},5]}},
        {"if": {"param":"patient"}, "eq": 1,
          "then": [
            {"set":{"local":"BP_SYS"},"value":{"clamp":[{"subtract":[{"local":"BP_SYS"},{"local":"fc_bp"}]},0,300]}}
        ]},
        {"if": {"param":"patient"}, "eq": 2,
          "then": [
            {"set":{"local":"P2_BP_SYS"},"value":{"clamp":[{"subtract":[{"local":"P2_BP_SYS"},{"local":"fc_bp"}]},0,300]}}
        ]},
        {"if": {"param":"patient"}, "eq": 3,
          "then": [
            {"set":{"local":"P3_BP_SYS"},"value":{"clamp":[{"subtract":[{"local":"P3_BP_SYS"},{"local":"fc_bp"}]},0,300]}}
        ]},
        {"set":{"local":"fc_amount"},"value":5}
      ],"else": [
        {"set":{"local":"fc_amount"},"value":{"param":"amount"}}
    ]},
    {"set":{"local":"fc_score"},"value":{"local":"LIFESCORE"}},
    {"if": {"param":"patient"}, "eq": 2,
      "then": [
        {"set":{"local":"fc_score"},"value":{"local":"LIFESCORE2"}}
    ]},
    {"if": {"param":"patient"}, "eq": 3,
      "then": [
        {"set":{"local":"fc_score"},"value":{"local":"LIFESCORE3"}}
    ]},
    {"set":{"local":"fc_score"},"value":{"clamp":[{"subtract":[{"local":"fc_score"},{"local":"fc_amount"}]},0,100]}},
    {"call_macro":"multipatient registry manual lifescore override","params":{"slot":{"param":"patient"},"score":{"local":"fc_score"}},"result":"fc_done"},
    {"if": {"local":"fc_done"}, "ne": 1,
      "then": [
        {"if": {"param":"patient"}, "eq": 1,
          "then": [
            {"set":{"local":"LIFESCORE"},"value":{"local":"fc_score"}}
        ]},
        {"if": {"param":"patient"}, "eq": 2,
          "then": [
            {"set":{"local":"LIFESCORE2"},"value":{"local":"fc_score"}}
        ]},
        {"if": {"param":"patient"}, "eq": 3,
          "then": [
            {"set":{"local":"LIFESCORE3"},"value":{"local":"fc_score"}}
        ]}
    ]},
    {"return":1}
  ],
