                    {"require":{"location":"heli_rescuer_location","var":"distance:m"},"lt":{"local":"ldg_spot_area_size"}}
                  ]}, "eq": 1,
                  "then": [
                    {"trigger_user_action":"begin_hoist_up"},
                    {"set":{"local":"sp_result"},"value":1}
                ]}
            ]}
          ],
          "catch": [
            {"set":{"local":"sp_error"},"value":1}
        ]}
    ]},
    {"if": {"param":"code"}, "eq": 103,
      "then": [
        {"try": [
            {"if": {"has_user_action":"begin_hoist_dwn"}, "eq": 1,
              "then": [
                {"if": {
                  "and": [
                    {"require":{"var":["GPS GROUND SPEED","knots"]},"lt":50},
