{
  "title": "CLOSEST DRIVE TEST",
  "id": "closest_drive_test",
  "start_info": {"icon_src":"","query":[]},
  "objectives": [
    {
      "title": "CLOSEST DRIVE TEST",
      "commands": [
        {"create_location":"heli","zones":[{"zone":{"location":"$USER"}}]},
        {"set":{"local":"t_status"},"value":"READY"},
        {"set":{"local":"t_idx"},"value":0},
        {"set":{"local":"cd_done"},"value":"no"},
        {"set":{"local":"t_res_1"},"value":""},
        {"set":{"local":"t_res_2"},"value":""},
        {"set":{"local":"t_res_3"},"value":""},
        {"set":{"local":"t_res_4"},"value":""},
        {"set":{"local":"t_res_5"},"value":""},
        {"set":{"local":"t_res_6"},"value":""},
        {"set":{"local":"t_res_7"},"value":""},
        {"set":{"local":"t_res_8"},"value":""},
        {"set":{"local":"t_res_9"},"value":""},
        {"set":{"local":"t_res_10"},"value":""},
        {"set":{"local":"t_res_11"},"value":""},
        {"set":{"local":"t_res_12"},"value":""},
        {"set":{"local":"t_res_13"},"value":""},
        {"set":{"local":"t_res_14"},"value":""},
        {"set":{"local":"t_res_15"},"value":""},
        {"set":{"local":"t_res_16"},"value":""},
        {"set":{"local":"t_res_17"},"value":""},
        {"set":{"local":"t_res_18"},"value":""},
        {"set":{"local":"t_res_19"},"value":""},
        {"set":{"local":"t_res_20"},"value":""},
        {"set":{"local":"t_res_21"},"value":""},
        {"set":{"local":"t_res_22"},"value":""},
        {"set":{"local":"t_res_23"},"value":""},
        {"set":{"local":"t_res_24"},"value":""},
        {"set_briefing_dialog":1},
        {"wait_for":1,"lt":0}
      ]
    }
  ],
  "macros": {
    "cd cleanup": [
      {"if":{"has_object":"tcrew"},"eq":1,"then":[{"try":[{"destroy_object":"tcrew"}],"catch":[{"set":{"local":"cd_err"},"value":{"param":"$ERROR"}}]}]},
      {"if":{"has_object":"tstr"},"eq":1,"then":[{"try":[{"destroy_object":"tstr"}],"catch":[{"set":{"local":"cd_err"},"value":{"param":"$ERROR"}}]}]},
      {"if":{"has_object":"tmed"},"eq":1,"then":[{"try":[{"destroy_object":"tmed"}],"catch":[{"set":{"local":"cd_err"},"value":{"param":"$ERROR"}}]}]}
    ],
    "cd thread simple": [
      {"#comment":"One drive of tcrew to the point t_T, VAR1 3 (walking with backpack), the speed is literal (1, 2 or 5 m/s): the mission walks the crew at 2 to 6 m/s."},
      {"try":[{"if":{"local":"cd_speed"},"eq":1,"then":[{"drive_object":{"name":"tcrew","to":["t_T"],"VAR1":3,"speed":1}}]},{"if":{"local":"cd_speed"},"eq":2,"then":[{"drive_object":{"name":"tcrew","to":["t_T"],"VAR1":3,"speed":2}}]},{"if":{"local":"cd_speed"},"eq":5,"then":[{"drive_object":{"name":"tcrew","to":["t_T"],"VAR1":3,"speed":5}}]},{"set":{"local":"cd_done"},"value":"yes"}],"catch":[{"set":{"local":"cd_err"},"value":{"param":"$ERROR"}},{"set":{"local":"cd_done"},"value":"error"}]}
    ],
    "cd thread eval single": [
      {"#comment":"One drive: far point t_P1 (40 m), then the closest of t_A (5 m behind the start) and t_B (5 m beyond t_P1), measured from tcrew. Evaluated at the start of the drive the nearest candidate is t_A; evaluated on arrival after t_P1 it is t_B."},
      {"try":[{"drive_object":{"name":"tcrew","to":["t_P1",{"closest":["t_A","t_B"],"to":"tcrew"}],"VAR1":3,"speed":5}},{"set":{"local":"cd_done"},"value":"yes"}],"catch":[{"set":{"local":"cd_err"},"value":{"param":"$ERROR"}},{"set":{"local":"cd_done"},"value":"error"}]}
    ],
    "cd thread eval split": [
      {"#comment":"The same walk as two drives: first t_P1, then the closest of t_A and t_B. The second drive starts at t_P1, so the closest must be t_B."},
      {"try":[{"drive_object":{"name":"tcrew","to":["t_P1"],"VAR1":3,"speed":5}},{"drive_object":{"name":"tcrew","to":[{"closest":["t_A","t_B"],"to":"tcrew"}],"VAR1":3,"speed":5}},{"set":{"local":"cd_done"},"value":"yes"}],"catch":[{"set":{"local":"cd_err"},"value":{"param":"$ERROR"}},{"set":{"local":"cd_done"},"value":"error"}]}
    ],
    "cd thread hospital": [
      {"#comment":"The second hoist_crew drive of User destination1 and Ambulance destination1: the closest of the four points 2 m around the stretcher, speed 2, cd_state 11 (trolley) or 3 (walking with backpack)."},
      {"try":[{"if":{"local":"cd_state"},"eq":11,"then":[{"drive_object":{"name":"tcrew","to":[{"closest":[{"bearing2":0,"dist":2,"object":"tstr"},{"bearing2":90,"dist":2,"object":"tstr"},{"bearing2":180,"dist":2,"object":"tstr"},{"bearing2":270,"dist":2,"object":"tstr"}],"to":"tcrew"}],"VAR1":11,"speed":2}}]},{"if":{"local":"cd_state"},"eq":3,"then":[{"drive_object":{"name":"tcrew","to":[{"closest":[{"bearing2":0,"dist":2,"object":"tstr"},{"bearing2":90,"dist":2,"object":"tstr"},{"bearing2":180,"dist":2,"object":"tstr"},{"bearing2":270,"dist":2,"object":"tstr"}],"to":"tcrew"}],"VAR1":3,"speed":2}}]},{"set":{"local":"cd_done"},"value":"yes"}],"catch":[{"set":{"local":"cd_err"},"value":{"param":"$ERROR"}},{"set":{"local":"cd_done"},"value":"error"}]}
    ],
    "cd watch": [
      {"#comment":"Waits for cd_done (the drive returned) or cd_limit seconds, every 0.5 s keeps the largest distance of tcrew from its start point t_S (cd_max) and the time (cd_elapsed)."},
      {"set":{"local":"cd_i"},"value":0},
      {"set":{"local":"cd_max"},"value":0},
      {"set":{"local":"cd_elapsed"},"value":0},
      {"while":{"local":"cd_i"},"lt":{"local":"cd_limit"},"do":[{"sleep":0.5},{"set":{"local":"cd_i"},"value":{"add":[{"local":"cd_i"},0.5]}},{"try":[{"set":{"local":"cd_cur"},"value":{"location":"tcrew","var":"distance:m","to":"t_S"}}],"catch":[{"set":{"local":"cd_cur"},"value":0}]},{"if":{"local":"cd_cur"},"gt":{"local":"cd_max"},"then":[{"set":{"local":"cd_max"},"value":{"local":"cd_cur"}}]},{"if":{"local":"cd_done"},"ne":"no","then":[{"set":{"local":"cd_elapsed"},"value":{"local":"cd_i"}},{"set":{"local":"cd_i"},"value":{"local":"cd_limit"}}]}]},
      {"if":{"local":"cd_done"},"eq":"no","then":[{"set":{"local":"cd_elapsed"},"value":{"local":"cd_limit"}}]}
    ],
    "cd info": [
      {"#comment":"The crew title is the one of the mission, $TITLE Crew (the crew model of the livery of the aircraft) with the ADAC crew as fallback: a livery with a different crew model is a difference between PCs."},
      {"set":{"table":{"static":"Closest_Test_Table"},"key":"info"},"value":"crew title requested: $TITLE Crew, fallback Airbus H145 ADAC Crew"}
    ],
    "cd add result": [
      {"set":{"local":"t_idx"},"value":{"add":[{"local":"t_idx"},1]}},
      {"set":{"local":"t_res_{local:t_idx}"},"value":{"local":"t_result"}},
      {"set":{"local":"cd_key"},"value":{"text":"test {0}","params":[{"local":"t_idx"}]}},
      {"set":{"table":{"static":"Closest_Test_Table"},"key":{"local":"cd_key"}},"value":{"local":"t_result"}}
    ],
    "cd status text": [
      {"set":{"local":"cd_state_text"},"value":"DONE"},
      {"if":{"local":"cd_done"},"eq":"no","then":[{"set":{"local":"cd_state_text"},"value":"NOT DONE (still walking)"}]},
      {"if":{"local":"cd_done"},"eq":"error","then":[{"set":{"local":"cd_state_text"},"value":{"text":"ERROR {0}","params":[{"local":"cd_err"}]}}]}
    ],
    "cd test eval single": [
      {"#comment":"Test 1 (one drive: P1 then closest): the crew starts at t_S, 40 m of free ground to the north (t_P1), t_A 5 m south of the start, t_B 5 m beyond t_P1."},
      {"call_macro":"cd cleanup"},
      {"create_location":"t_S","zones":[{"zone":{"location":{"bearing":0,"dist":30,"object":"heli"}}}]},
      {"create_location":"t_P1","zones":[{"zone":{"location":{"bearing":0,"dist":40,"object":"t_S"}}}]},
      {"create_location":"t_A","zones":[{"zone":{"location":{"bearing":180,"dist":5,"object":"t_S"}}}]},
      {"create_location":"t_B","zones":[{"zone":{"location":{"bearing":0,"dist":45,"object":"t_S"}}}]},
      {"create_object":{"name":"tcrew","title":"$TITLE Crew","fallback_title":"Airbus H145 ADAC Crew","location":"t_S"}},
      {"wait_for":{"has_object":"tcrew"},"eq":1},
      {"sleep":1},
      {"set":{"object":"tcrew","var":"VAR 1"},"value":0},
      {"set":{"local":"cd_done"},"value":"no"},
      {"set":{"local":"cd_limit"},"value":60},
      {"create_thread":{"commands":[{"call_macro":"cd thread eval single"}]}},
      {"call_macro":"cd watch"},
      {"call_macro":"cd status text"},
      {"try":[{"set":{"local":"cd_dA"},"value":{"location":"tcrew","var":"distance:m","to":"t_A"}},{"set":{"local":"cd_dB"},"value":{"location":"tcrew","var":"distance:m","to":"t_B"}}],"catch":[{"set":{"local":"cd_dA"},"value":-1},{"set":{"local":"cd_dB"},"value":-1}]},
      {"set":{"local":"cd_verdict"},"value":"ends at neither point"},
      {"if":{"local":"cd_dA"},"gte":0,"then":[{"if":{"local":"cd_dA"},"lt":4,"then":[{"set":{"local":"cd_verdict"},"value":"ENDS AT A = closest chosen at the START of the drive"}]}]},
      {"if":{"local":"cd_dB"},"gte":0,"then":[{"if":{"local":"cd_dB"},"lt":4,"then":[{"set":{"local":"cd_verdict"},"value":"ENDS AT B = closest chosen when the point is reached"}]}]},
      {"set":{"local":"t_result"},"value":{"text":"T1 one drive: {0}; {1} in {2} s; to A {3} m, to B {4} m, farthest from the start {5} m","params":[{"local":"cd_verdict"},{"local":"cd_state_text"},{"tofixed":{"local":"cd_elapsed"},"digits":1},{"tofixed":{"local":"cd_dA"},"digits":1},{"tofixed":{"local":"cd_dB"},"digits":1},{"tofixed":{"local":"cd_max"},"digits":1}]}},
      {"call_macro":"cd add result"},
      {"call_macro":"cd cleanup"}
    ],
    "cd test eval split": [
      {"#comment":"Test 1 (two drives): the crew starts at t_S, 40 m of free ground to the north (t_P1), t_A 5 m south of the start, t_B 5 m beyond t_P1."},
      {"call_macro":"cd cleanup"},
      {"create_location":"t_S","zones":[{"zone":{"location":{"bearing":0,"dist":30,"object":"heli"}}}]},
      {"create_location":"t_P1","zones":[{"zone":{"location":{"bearing":0,"dist":40,"object":"t_S"}}}]},
      {"create_location":"t_A","zones":[{"zone":{"location":{"bearing":180,"dist":5,"object":"t_S"}}}]},
      {"create_location":"t_B","zones":[{"zone":{"location":{"bearing":0,"dist":45,"object":"t_S"}}}]},
      {"create_object":{"name":"tcrew","title":"$TITLE Crew","fallback_title":"Airbus H145 ADAC Crew","location":"t_S"}},
      {"wait_for":{"has_object":"tcrew"},"eq":1},
      {"sleep":1},
      {"set":{"object":"tcrew","var":"VAR 1"},"value":0},
      {"set":{"local":"cd_done"},"value":"no"},
      {"set":{"local":"cd_limit"},"value":60},
      {"create_thread":{"commands":[{"call_macro":"cd thread eval split"}]}},
      {"call_macro":"cd watch"},
      {"call_macro":"cd status text"},
      {"try":[{"set":{"local":"cd_dA"},"value":{"location":"tcrew","var":"distance:m","to":"t_A"}},{"set":{"local":"cd_dB"},"value":{"location":"tcrew","var":"distance:m","to":"t_B"}}],"catch":[{"set":{"local":"cd_dA"},"value":-1},{"set":{"local":"cd_dB"},"value":-1}]},
      {"set":{"local":"cd_verdict"},"value":"ends at neither point"},
      {"if":{"local":"cd_dA"},"gte":0,"then":[{"if":{"local":"cd_dA"},"lt":4,"then":[{"set":{"local":"cd_verdict"},"value":"ENDS AT A = closest chosen at the START of the drive"}]}]},
      {"if":{"local":"cd_dB"},"gte":0,"then":[{"if":{"local":"cd_dB"},"lt":4,"then":[{"set":{"local":"cd_verdict"},"value":"ENDS AT B = closest chosen when the point is reached"}]}]},
      {"set":{"local":"t_result"},"value":{"text":"T1 two drives: {0}; {1} in {2} s; to A {3} m, to B {4} m, farthest from the start {5} m","params":[{"local":"cd_verdict"},{"local":"cd_state_text"},{"tofixed":{"local":"cd_elapsed"},"digits":1},{"tofixed":{"local":"cd_dA"},"digits":1},{"tofixed":{"local":"cd_dB"},"digits":1},{"tofixed":{"local":"cd_max"},"digits":1}]}},
      {"call_macro":"cd add result"},
      {"call_macro":"cd cleanup"}
    ],
    "cd test short": [
      {"#comment":"Test 2: the route is one point t_T at cd_d metres from the crew (0 = the same point). cd_speed 1, 2 or 5 m/s. Result: returned or not, time, the farthest distance from the start, the final distance to the target."},
      {"call_macro":"cd cleanup"},
      {"create_location":"t_S","zones":[{"zone":{"location":{"bearing":0,"dist":30,"object":"heli"}}}]},
      {"create_location":"t_T","zones":[{"zone":{"location":{"bearing":0,"dist":{"local":"cd_d"},"object":"t_S"}}}]},
      {"create_object":{"name":"tcrew","title":"$TITLE Crew","fallback_title":"Airbus H145 ADAC Crew","location":"t_S"}},
      {"wait_for":{"has_object":"tcrew"},"eq":1},
      {"sleep":1},
      {"set":{"object":"tcrew","var":"VAR 1"},"value":0},
      {"set":{"local":"cd_done"},"value":"no"},
      {"set":{"local":"cd_limit"},"value":30},
      {"create_thread":{"commands":[{"call_macro":"cd thread simple"}]}},
      {"call_macro":"cd watch"},
      {"call_macro":"cd status text"},
      {"try":[{"set":{"local":"cd_gap"},"value":{"location":"tcrew","var":"distance:m","to":"t_T"}}],"catch":[{"set":{"local":"cd_gap"},"value":-1}]},
      {"set":{"local":"t_result"},"value":{"text":"T2 route {0} m at {1} m/s: {2} in {3} s; farthest from the start {4} m; ends {5} m from the target","params":[{"tofixed":{"local":"cd_d"},"digits":1},{"local":"cd_speed"},{"local":"cd_state_text"},{"tofixed":{"local":"cd_elapsed"},"digits":1},{"tofixed":{"local":"cd_max"},"digits":1},{"tofixed":{"local":"cd_gap"},"digits":1}]}},
      {"call_macro":"cd add result"},
      {"call_macro":"cd cleanup"}
    ],
    "cd test hospital": [
      {"#comment":"Test 3: the drive of the hospital handover. A stretcher tstr stands at t_S; the crew stands 1.5 m behind it (cd_side 180) or beside it (90) and drives to the closest of the four points 2 m around the stretcher (0.5 to 1.4 m away), as hoist_crew does in User destination1 and Ambulance destination1. cd_state 11 or 3."},
      {"call_macro":"cd cleanup"},
      {"create_location":"t_S","zones":[{"zone":{"location":{"bearing":0,"dist":30,"object":"heli"}}}]},
      {"create_object":{"name":"tstr","title":"Airbus H145 Medic Stretcher","fallback_title":"Airbus H145 Medic Stretcher","location":"t_S"}},
      {"wait_for":{"has_object":"tstr"},"eq":1},
      {"sleep":1},
      {"if":{"local":"cd_side"},"eq":180,"then":[{"create_object":{"name":"tcrew","title":"$TITLE Crew","fallback_title":"Airbus H145 ADAC Crew","location":{"bearing2":180,"dist":1.5,"object":"tstr"}}}]},
      {"if":{"local":"cd_side"},"eq":90,"then":[{"create_object":{"name":"tcrew","title":"$TITLE Crew","fallback_title":"Airbus H145 ADAC Crew","location":{"bearing2":90,"dist":1.5,"object":"tstr"}}}]},
      {"wait_for":{"has_object":"tcrew"},"eq":1},
      {"sleep":1},
      {"set":{"object":"tcrew","var":"VAR 1"},"value":0},
      {"try":[{"set":{"local":"cd_start_gap"},"value":{"location":"tcrew","var":"distance:m","to":"tstr"}}],"catch":[{"set":{"local":"cd_start_gap"},"value":-1}]},
      {"set":{"local":"cd_done"},"value":"no"},
      {"set":{"local":"cd_limit"},"value":30},
      {"create_thread":{"commands":[{"call_macro":"cd thread hospital"}]}},
      {"call_macro":"cd watch"},
      {"call_macro":"cd status text"},
      {"try":[{"set":{"local":"cd_end_gap"},"value":{"location":"tcrew","var":"distance:m","to":"tstr"}}],"catch":[{"set":{"local":"cd_end_gap"},"value":-1}]},
      {"set":{"local":"t_result"},"value":{"text":"T3 crew {0} m from the stretcher (side {1}, VAR1 {2}): {3} in {4} s; farthest from the start {5} m; ends {6} m from the stretcher","params":[{"tofixed":{"local":"cd_start_gap"},"digits":1},{"local":"cd_side"},{"local":"cd_state"},{"local":"cd_state_text"},{"tofixed":{"local":"cd_elapsed"},"digits":1},{"tofixed":{"local":"cd_max"},"digits":1},{"tofixed":{"local":"cd_end_gap"},"digits":1}]}},
      {"call_macro":"cd add result"},
      {"call_macro":"cd cleanup"}
    ],
    "cd thread closest0": [
      {"#comment":"One drive with a closest whose nearest candidate is where the crew already stands (cd_gap 0) or 0.3 m away, as the approach point of the quad SAR (169.43). cd_state 3 or 11, speed 2."},
      {"try":[{"if":{"local":"cd_state"},"eq":11,"then":[{"drive_object":{"name":"tcrew","to":[{"closest":["t_A","t_B"],"to":"tcrew"}],"VAR1":11,"speed":2}}]},{"if":{"local":"cd_state"},"eq":3,"then":[{"drive_object":{"name":"tcrew","to":[{"closest":["t_A","t_B"],"to":"tcrew"}],"VAR1":3,"speed":2}}]},{"set":{"local":"cd_done"},"value":"yes"}],"catch":[{"set":{"local":"cd_err"},"value":{"param":"$ERROR"}},{"set":{"local":"cd_done"},"value":"error"}]}
    ],
    "cd test closest0": [
      {"#comment":"Test 4: closest(t_A, t_B) with t_A at cd_gap metres from the crew (0 = the crew stands on it) and t_B 10 m north."},
      {"call_macro":"cd cleanup"},
      {"create_location":"t_S","zones":[{"zone":{"location":{"bearing":0,"dist":30,"object":"heli"}}}]},
      {"create_location":"t_A","zones":[{"zone":{"location":{"bearing":0,"dist":{"local":"cd_gap_in"},"object":"t_S"}}}]},
      {"create_location":"t_B","zones":[{"zone":{"location":{"bearing":0,"dist":10,"object":"t_S"}}}]},
      {"create_object":{"name":"tcrew","title":"$TITLE Crew","fallback_title":"Airbus H145 ADAC Crew","location":"t_S"}},
      {"wait_for":{"has_object":"tcrew"},"eq":1},
      {"sleep":1},
      {"set":{"object":"tcrew","var":"VAR 1"},"value":0},
      {"set":{"local":"cd_done"},"value":"no"},
      {"set":{"local":"cd_limit"},"value":30},
      {"create_thread":{"commands":[{"call_macro":"cd thread closest0"}]}},
      {"call_macro":"cd watch"},
      {"call_macro":"cd status text"},
      {"try":[{"set":{"local":"cd_gap"},"value":{"location":"tcrew","var":"distance:m","to":"t_A"}}],"catch":[{"set":{"local":"cd_gap"},"value":-1}]},
      {"set":{"local":"t_result"},"value":{"text":"T4 closest with the crew {0} m from the nearest candidate (VAR1 {1}): {2} in {3} s; farthest from the start {4} m; ends {5} m from the candidate","params":[{"tofixed":{"local":"cd_gap_in"},"digits":1},{"local":"cd_state"},{"local":"cd_state_text"},{"tofixed":{"local":"cd_elapsed"},"digits":1},{"tofixed":{"local":"cd_max"},"digits":1},{"tofixed":{"local":"cd_gap"},"digits":1}]}},
      {"call_macro":"cd add result"},
      {"call_macro":"cd cleanup"}
    ],
    "cd test hospital2": [
      {"#comment":"Test 5: as test 3 (crew 1.5 m behind the stretcher, VAR1 11) with a second crew object tmed standing exactly on the point the crew drives to (cd_occ 180 = the nearest point, behind the stretcher) or on another point (90). The mission has the hospital medic near the stretcher."},
      {"call_macro":"cd cleanup"},
      {"create_location":"t_S","zones":[{"zone":{"location":{"bearing":0,"dist":30,"object":"heli"}}}]},
      {"create_object":{"name":"tstr","title":"Airbus H145 Medic Stretcher","fallback_title":"Airbus H145 Medic Stretcher","location":"t_S"}},
      {"wait_for":{"has_object":"tstr"},"eq":1},
      {"sleep":1},
      {"if":{"local":"cd_occ"},"eq":180,"then":[{"create_object":{"name":"tmed","title":"$TITLE Crew","fallback_title":"Airbus H145 ADAC Crew","location":{"bearing2":180,"dist":2,"object":"tstr"}}}]},
      {"if":{"local":"cd_occ"},"eq":90,"then":[{"create_object":{"name":"tmed","title":"$TITLE Crew","fallback_title":"Airbus H145 ADAC Crew","location":{"bearing2":90,"dist":2,"object":"tstr"}}}]},
      {"create_object":{"name":"tcrew","title":"$TITLE Crew","fallback_title":"Airbus H145 ADAC Crew","location":{"bearing2":180,"dist":1.5,"object":"tstr"}}},
      {"wait_for":{"has_object":"tcrew"},"eq":1},
      {"wait_for":{"has_object":"tmed"},"eq":1},
      {"sleep":1},
      {"set":{"object":"tcrew","var":"VAR 1"},"value":0},
      {"set":{"object":"tmed","var":"VAR 1"},"value":0},
      {"set":{"local":"cd_state"},"value":11},
      {"set":{"local":"cd_done"},"value":"no"},
      {"set":{"local":"cd_limit"},"value":30},
      {"create_thread":{"commands":[{"call_macro":"cd thread hospital"}]}},
      {"call_macro":"cd watch"},
      {"call_macro":"cd status text"},
      {"try":[{"set":{"local":"cd_end_gap"},"value":{"location":"tcrew","var":"distance:m","to":"tstr"}},{"set":{"local":"cd_med_gap"},"value":{"location":"tcrew","var":"distance:m","to":"tmed"}}],"catch":[{"set":{"local":"cd_end_gap"},"value":-1},{"set":{"local":"cd_med_gap"},"value":-1}]},
      {"set":{"local":"t_result"},"value":{"text":"T5 second crew on the point at {0} (VAR1 11): {1} in {2} s; farthest from the start {3} m; ends {4} m from the stretcher, {5} m from the second crew","params":[{"local":"cd_occ"},{"local":"cd_state_text"},{"tofixed":{"local":"cd_elapsed"},"digits":1},{"tofixed":{"local":"cd_max"},"digits":1},{"tofixed":{"local":"cd_end_gap"},"digits":1},{"tofixed":{"local":"cd_med_gap"},"digits":1}]}},
      {"call_macro":"cd add result"},
      {"call_macro":"cd cleanup"}
    ],
    "cd run test1": [
      {"create_location":"heli","zones":[{"zone":{"location":"$USER"}}]},
      {"open_table":{"static":"Closest_Test_Table"}},
      {"call_macro":"cd info"},
      {"set":{"local":"t_idx"},"value":0},
