  "macros": {
    "dn v1 param name": [
      {
        "#comment": "V1: a local whose name is built with {param:cat}. Is the same local reached by the interpolated name and by the literal name dn_RTC?"
      },
      {
        "set": {
          "local": "v1a"
        },
        "value": "NO"
      },
      {
        "set": {
          "local": "v1b"
        },
        "value": "NO"
      },
      {
        "set": {
          "local": "dn_{param:cat}"
        },
        "value": 7
      },
      {
        "if": {
          "local": "dn_{param:cat}"
        },
        "eq": 7,
        "then": [
          {
            "set": {
              "local": "v1a"
            },
            "value": "YES"
          }
        ]
      },
      {
        "if": {
          "local": "dn_RTC"
        },
        "eq": 7,
        "then": [
          {
            "set": {
              "local": "v1b"
            },
            "value": "YES"
          }
        ]
      },
      {
        "set": {
          "local": "r_v1"
        },
        "value": {
          "text": "V1 name with {param:cat}: set and read by the interpolated name = {0}; read by the literal name dn_RTC = {1}",
          "params": [
            {
              "local": "v1a"
            },
            {
              "local": "v1b"
            }
          ]
        }
      }
    ],
    "dn v2 local name": [
