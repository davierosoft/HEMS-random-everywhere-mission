    "scope set": [
      {
        "#comment": "Writes a marker into one LOCAL and one GLOBAL for the calling context (param ctx = OBJ, BTN, THR or EVT). Value = running sequence number."
      },
      {
        "set": {
          "global": "SC_SEQ"
