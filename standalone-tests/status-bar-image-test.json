{
 "title": "STATUS BAR IMAGE TEST",
 "id": "status_bar_image_test",
 "start_info": {
  "icon_src": "",
  "query": []
 },
 "icons": {
  "homebar": "data:image/png;base64,",
  "homebar5g": "data:image/png;base64,",
  "wifi": "data:image/png;base64,",
  "wifigo": "data:image/png;base64,"
 },
 "objectives": [
  {
   "title": "STATUS BAR IMAGE TEST",
   "commands": [
    {
     "create_location": "heli",
     "zones": [
      {
       "zone": {
        "location": "$USER"
       }
      }
     ]
    },
    {
     "set": {
      "local": "IMG_A"
     },
     "value": "homebar"
    },
    {
     "set": {
      "global": "IMG_B"
     },
     "value": "homebar"
    },
    {
     "set": {
      "local": "FLAG_C"
     },
     "value": 0
    },
    {
     "set": {
      "local": "IMG_D"
     },
     "value": "homebar"
    },
    {
     "set_briefing_dialog": 1
    },
    {
     "wait_for": 1,
     "lt": 0
    }
   ]
  }
 ],
 "macros": {
  "dispatch page image test": [
   {
    "#comment": "Form D: the image of a set_dispatch page chosen by a local (the real use of the status bar is in the dispatch pages)."
   },
   {
    "set_dispatch": [
     {
      "image": {
       "local": "IMG_D"
      }
     },
     {
      "text": "Dispatch page: the bar above must be {0}",
      "params": [
       {
        "local": "IMG_D"
       }
      ],
      "align": "center"
     },
     {
      "buttonbar": [
       {
        "title": "TOGGLE D",
        "commands": [
         {
          "set": {
           "local": "IMG_D"
          },
          "value": {
           "if": {
            "local": "IMG_D"
           },
           "eq": "homebar",
           "then": "homebar5g",
           "else": "homebar"
          }
         },
         {
          "call_macro": "dispatch page image test"
         }
        ]
       },
       {
        "title": "BACK",
        "commands": [
         {
          "set_dispatch_dialog": 0
         },
         {
          "set_briefing_dialog": 1
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "set_dispatch_dialog": 1
   }
  ]
 },
 "briefing": [
  {
   "text": "STATUS BAR IMAGE TEST",
   "size": "large",
   "align": "center"
  },
  {
   "text": "Can the image of the status bar be chosen by a variable? Reference bars first (static names), then four forms. After each button the bar of that form must change between the plain bar and the bar with 5G. Report which forms change (A local, B global, C inline if, D dispatch page with a local) and whether any shows nothing or an error."
  },
  {
   "text": "REFERENCE: static homebar",
   "align": "center",
   "color": "gray"
  },
  {
   "image": "homebar"
  },
  {
   "text": "REFERENCE: static homebar5g",
   "align": "center",
   "color": "gray"
  },
  {
   "image": "homebar5g"
  },
  {
   "text": "FORM A: image from a local (now {0})",
   "params": [
    {
     "local": "IMG_A"
    }
   ],
   "align": "center",
   "color": "green"
  },
  {
   "image": {
    "local": "IMG_A"
   }
  },
  {
   "buttonbar": [
    {
     "title": "A: homebar",
     "commands": [
      {
       "set": {
        "local": "IMG_A"
       },
       "value": "homebar"
      }
     ]
    },
    {
     "title": "A: homebar5g",
     "commands": [
      {
       "set": {
        "local": "IMG_A"
       },
       "value": "homebar5g"
      }
     ]
    }
   ]
  },
  {
   "text": "FORM B: image from a global (now {0})",
   "params": [
    {
     "global": "IMG_B"
    }
   ],
   "align": "center",
   "color": "green"
  },
  {
   "image": {
    "global": "IMG_B"
   }
  },
  {
   "buttonbar": [
    {
     "title": "B: homebar",
     "commands": [
      {
       "set": {
        "global": "IMG_B"
       },
       "value": "homebar"
      }
     ]
    },
    {
     "title": "B: homebar5g",
     "commands": [
      {
       "set": {
        "global": "IMG_B"
       },
       "value": "homebar5g"
      }
     ]
    }
   ]
  },
  {
   "text": "FORM C: image from an inline if (flag {0})",
   "params": [
    {
     "local": "FLAG_C"
    }
   ],
   "align": "center",
   "color": "green"
  },
  {
   "image": {
    "if": {
     "local": "FLAG_C"
    },
    "eq": 1,
    "then": "homebar5g",
    "else": "homebar"
   }
  },
  {
   "buttonbar": [
    {
     "title": "C: flag 0",
     "commands": [
      {
       "set": {
        "local": "FLAG_C"
       },
       "value": 0
      }
     ]
    },
    {
     "title": "C: flag 1",
     "commands": [
      {
       "set": {
        "local": "FLAG_C"
       },
       "value": 1
      }
     ]
    }
   ]
  },
  {
   "text": "FORM D: image of a dispatch page from a local",
   "align": "center",
   "color": "green"
  },
  {
   "buttonbar": [
    {
     "title": "OPEN DISPATCH PAGE",
     "commands": [
      {
       "set_briefing_dialog": 0
      },
      {
       "call_macro": "dispatch page image test"
      }
     ]
    }
   ]
  }
 ]
}